<Window x:Class="musicPlayer.SiteManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="已添加站点" Height="660" Width="880"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#FF0E0E15"
        WindowStyle="None"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 与设置窗口同一套无边框外观：拖拽交给 40px 的 CaptionHeight -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="40"
                      CornerRadius="0" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFE8B93A" Offset="0"/>
            <GradientStop Color="#FFD9A521" Offset="1"/>
        </LinearGradientBrush>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 幽灵按钮（悬停柔光，与主窗口/设置一致） -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#30FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#14FFFFFF" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#44666666"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（金色渐变） -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF201800"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{StaticResource AccentGradient}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险操作（删除）：红色文字，悬停红底 -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="#E6FF6B6B"/>
        </Style>

        <!-- 状态徽章 -->
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- 关键词输入框 -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="#B80E0E15">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="🌐" Foreground="#FFD700" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="已添加站点" Foreground="#CCFFFFFF" FontSize="12"
                               FontWeight="SemiBold" Margin="9,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnTitleClose" Content="✕" Click="btnClose_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Width="40" FontSize="10" Padding="0"
                        ToolTip="关闭" Cursor="Hand"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.Foreground="#AAFFFFFF"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                    <Setter Property="TextBlock.Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ================= 内容 ================= -->
        <Grid Grid.Row="1" Margin="22,14,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 说明 + 测试关键词 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="管理在线站点：测试、重新点选、登录、删除"
                               FontSize="12.5" Foreground="#B0FFFFFF"/>
                    <TextBlock x:Name="txtSummary" Text="共 0 个站点"
                               FontSize="11" Foreground="#77AAAAAA" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTip="「测试」和「登录」都会用这个关键词打开搜索页">
                    <TextBlock Text="测试关键词" FontSize="11.5" Foreground="#88FFFFFF"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="txtKeyword" Width="150" Text="夜曲"
                             Style="{StaticResource DarkTextBox}"
                             KeyDown="txtKeyword_KeyDown"/>
                </StackPanel>
            </Grid>

            <!-- 站点列表 -->
            <Border Grid.Row="1" Background="#121218" BorderBrush="#1FFFFFFF"
                    BorderThickness="1" CornerRadius="14">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <ItemsControl x:Name="listSites">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#16141420" BorderBrush="#1AFFFFFF"
                                            BorderThickness="1" CornerRadius="12"
                                            Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 图标：字母徽章打底，favicon 加载成功则覆盖 -->
                                            <Grid Grid.Column="0" Width="42" Height="42"
                                                  VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Border CornerRadius="10" Background="#24FFD700">
                                                    <TextBlock Text="{Binding Initial}" FontSize="16"
                                                               FontWeight="Bold" Foreground="#CCFFD700"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border CornerRadius="10" Background="Transparent"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding FaviconUrl}"
                                                           ImageFailed="Favicon_ImageFailed"
                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                            </Grid>

                                            <!-- 名称 / 状态 / 主机 / 最近成功 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                               FontWeight="SemiBold" Foreground="#F2FFFFFF"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="330" VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource StatusBadge}"
                                                            Background="{Binding StatusBg}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding StatusFg}"/>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock FontSize="11" Foreground="#77AAAAAA" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="420">
                                                    <Run Text="{Binding Host, Mode=OneWay}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding LastOkText, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Hint}" FontSize="11" Margin="0,4,0,0"
                                                           Foreground="#CCFF8A65" TextWrapping="Wrap"
                                                           MaxWidth="420"
                                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>

                                            <!-- 操作 -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="测试" Style="{StaticResource GhostButton}"
                                                        Margin="0,0,6,0" Click="btnTest_Click"
                                                        ToolTip="用左侧关键词真搜一次，验证配置与网络"/>
                                                <Button Content="重配" Style="{StaticResource GhostButton}"
                                                        Margin="0,0,6,0" Click="btnReconfig_Click"
                                                        ToolTip="重新打开页面点选选择器（不改变已下载文件）"/>
                                                <Button Content="登录" Style="{StaticResource GhostButton}"
                                                        Margin="0,0,6,0" Click="btnLogin_Click"
                                                        ToolTip="打开站点页面完成一次登录，登录态保存在本机"/>
                                                <Button Content="删除" Style="{StaticResource DangerButton}"
                                                        Click="btnDelete_Click"
                                                        ToolTip="删除站点配置与本站 Cookie（已下载的音乐保留）"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 空态 -->
                    <StackPanel x:Name="emptyState" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="还没有添加站点" FontSize="13" Foreground="#88FFFFFF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="点下面的「＋ 添加站点」，按三步向导配一个" FontSize="11.5"
                                   Foreground="#66AAAAAA" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 底栏 -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnAdd" Content="＋ 添加站点" Style="{StaticResource AccentButton}"
                            Click="btnAdd_Click"/>
                    <TextBlock x:Name="txtStatus" Text="" FontSize="11.5" Foreground="#88AAAAAA"
                               Margin="14,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                </StackPanel>

                <Button Content="关 闭" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                        MinWidth="80" Click="btnClose_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
