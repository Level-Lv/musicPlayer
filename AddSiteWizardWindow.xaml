<Window x:Class="musicPlayer.AddSiteWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加在线站点" Width="1140" Height="780" MinWidth="960" MinHeight="640"
        WindowStyle="None" Background="#14141E" WindowStartupLocation="Manual"
        ShowInTaskbar="True" ShowActivated="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- 与验证窗口同样的约束：不能用 AllowsTransparency（分层窗口容不下 WebView2 原生子窗口），
         圆角交给 DWM。第 2 步的网页区域必须是实打实的矩形，顶栏/底栏/右侧面板都画在矩形之外。 -->

    <Window.Resources>
        <!-- 普通按钮 -->
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（金色） -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
            <Setter Property="Background" Value="#FFD700"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,8"/>
        </Style>

        <!-- 输入框 -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFD700"/>
            <Setter Property="SelectionBrush" Value="#66FFD700"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#99FFD700"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字段行里的"点选"小按钮 -->
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 步骤徽章文字 -->
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#70FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ═════════ 顶栏：标题 + 步骤指示 ═════════ -->
        <Border Grid.Row="0" Background="#191925" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="10" Background="#33FFD700">
                        <TextBlock Text="🌐" FontSize="14" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="txtTitle" Text="添加在线站点" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="#F2FFFFFF" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- 步骤指示：1 模板 → 2 点选 → 3 确认 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="chip1" CornerRadius="11" Padding="12,4" Background="#33FFD700">
                        <TextBlock x:Name="chip1Text" Text="1  搜索模板" Style="{StaticResource StepText}"
                                   Foreground="#FFD700"/>
                    </Border>
                    <TextBlock Text="›" Foreground="#40FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                    <Border x:Name="chip2" CornerRadius="11" Padding="12,4" Background="#12FFFFFF">
                        <TextBlock x:Name="chip2Text" Text="2  点选配置" Style="{StaticResource StepText}"/>
                    </Border>
                    <TextBlock Text="›" Foreground="#40FFFFFF" Margin="8,0" VerticalAlignment="Center"/>
                    <Border x:Name="chip3" CornerRadius="11" Padding="12,4" Background="#12FFFFFF">
                        <TextBlock x:Name="chip3Text" Text="3  确认保存" Style="{StaticResource StepText}"/>
                    </Border>
                </StackPanel>

                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="30" Height="28" FontSize="12" Cursor="Hand" Padding="0"
                        Style="{StaticResource WinButton}" Background="#14FFFFFF"
                        Click="btnClose_Click"/>
            </Grid>
        </Border>

        <!-- ═════════ 内容区 ═════════ -->
        <Grid Grid.Row="1">

            <!-- ───────── 第 1 步：粘贴网址 → 反推模板 ───────── -->
            <ScrollViewer x:Name="step1Panel" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" Margin="0,28,0,24" HorizontalAlignment="Center">
                    <TextBlock Text="把「搜索之后」的网页地址粘进来" FontSize="19" FontWeight="SemiBold"
                               Foreground="#F5FFFFFF"/>
                    <TextBlock Text="程序会把里面的关键词换成 {q}，以后搜索就自动替换成你输入的关键词。"
                               FontSize="12.5" Foreground="#80CCCCCC" Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <TextBlock Text="① 搜索结果页网址" FontSize="12" Foreground="#B0CCCCCC" Margin="0,24,0,7"/>
                    <Grid>
                        <TextBox x:Name="txtResultUrl" Style="{StaticResource Field}" Height="40"
                                 VerticalContentAlignment="Center" FontFamily="Consolas, Microsoft YaHei UI"
                                 KeyDown="txtResultUrl_KeyDown"/>
                        <Button Content="粘贴" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,6,0" Style="{StaticResource TinyButton}" Click="btnPaste_Click"/>
                    </Grid>

                    <TextBlock Text="② 当时搜索的关键词（用来定位 {q} 的位置）" FontSize="12"
                               Foreground="#B0CCCCCC" Margin="0,16,0,7"/>
                    <TextBox x:Name="txtKeyword" Style="{StaticResource Field}" Height="40" Width="320"
                             HorizontalAlignment="Left" VerticalContentAlignment="Center"
                             KeyDown="txtKeyword_KeyDown"/>

                    <Button x:Name="btnInfer" Content="生成搜索模板" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Margin="0,18,0,0" Click="btnInfer_Click"/>

                    <TextBlock Text="③ 搜索模板（可直接改；必须包含 {q}，可选 {p} 表示页码）" FontSize="12"
                               Foreground="#B0CCCCCC" Margin="0,24,0,7"/>
                    <TextBox x:Name="txtTemplate" Style="{StaticResource Field}" Height="40"
                             VerticalContentAlignment="Center" FontFamily="Consolas, Microsoft YaHei UI"
                             TextChanged="txtTemplate_TextChanged"/>

                    <TextBlock x:Name="txtTemplateHint" FontSize="12" Foreground="#FFC107"
                               Margin="0,8,0,0" TextWrapping="Wrap"/>

                    <!-- 页面信息（名称/图标给第 3 步当默认值） -->
                    <Border Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="14,12" Margin="0,22,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#1FFFFFFF">
                                <Image x:Name="imgFavicon" Width="20" Height="20"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="页面识别" FontSize="11.5" Foreground="#70CCCCCC"/>
                                <TextBlock x:Name="txtPageTitle" Text="粘贴网址并生成模板后自动识别"
                                           FontSize="12.5" Foreground="#D9FFFFFF" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="620"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock FontSize="11.5" Foreground="#5FFFFFFF" Margin="0,20,0,0" TextWrapping="Wrap"
                               Text="小提示：随便搜一个词（比如「测试」），把浏览器地址栏里的完整地址复制过来即可。&#10;如果网址里找不到关键词，直接把地址里的关键词改成 {q} 也能用。"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ───────── 第 2 步：网页点选 ───────── -->
            <Grid x:Name="step2Panel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <!-- 左：提示条 + 网页区域（内核会精确覆盖这一块矩形） -->
                <Grid Grid.Column="0" Margin="14,12,8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1A26" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock x:Name="txtPickHint" Text="正在加载搜索结果页…" FontSize="12"
                                       Foreground="#C0CCCCCC" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Content="重新加载" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource TinyButton}" Click="btnReloadPage_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#0B0B12" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            CornerRadius="8">
                        <Grid x:Name="contentHost" Background="#0B0B12" ClipToBounds="True">
                            <!-- 内核显示后这块不能有任何 WPF 内容（会被原生子窗口盖住） -->
                            <StackPanel x:Name="pickPlaceholder" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="◌" FontSize="26" Foreground="#40FFD700"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="正在打开页面…" FontSize="12" Foreground="#66CCCCCC"
                                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 右：字段配置 + 预览 -->
                <Border Grid.Column="1" Background="#191925" BorderBrush="#1FFFFFFF" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,16,16,16">
                            <Grid>
                                <TextBlock Text="字段配置" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#F2FFFFFF" VerticalAlignment="Center"/>
                                <Button Content="自动识别" HorizontalAlignment="Right"
                                        Style="{StaticResource TinyButton}" Click="btnAutoGuess_Click"/>
                            </Grid>
                            <TextBlock Text="点「点选」后在左边网页上单击目标元素" FontSize="11"
                                       Foreground="#5FFFFFFF" Margin="0,6,0,10" TextWrapping="Wrap"/>

                            <!-- 六个字段行：标签 / 当前选择器 / 点选按钮 -->
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="结果项" FontSize="12" Foreground="#FFD700" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSelItem" Grid.Column="1" Text="未设置" FontSize="11"
                                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="#80CCCCCC"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowDuration="20000"/>
                                <Button Grid.Column="2" Content="点选" Style="{StaticResource TinyButton}"
                                        Tag="item" Click="btnPickField_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标题" FontSize="12" Foreground="#D9FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSelTitle" Grid.Column="1" Text="未设置" FontSize="11"
                                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="#80CCCCCC"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ShowDuration="20000"/>
                                <Button Grid.Column="2" Content="点选" Style="{StaticResource TinyButton}"
                                        Tag="title" Click="btnPickField_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="艺人" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSelArtist" Grid.Column="1" Text="可选" FontSize="11"
                                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="#66CCCCCC"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="点选" Style="{StaticResource TinyButton}"
                                        Tag="artist" Click="btnPickField_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="时长" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSelDuration" Grid.Column="1" Text="可选" FontSize="11"
                                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="#66CCCCCC"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="点选" Style="{StaticResource TinyButton}"
                                        Tag="duration" Click="btnPickField_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="封面" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSelCover" Grid.Column="1" Text="可选" FontSize="11"
                                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="#66CCCCCC"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="点选" Style="{StaticResource TinyButton}"
                                        Tag="cover" Click="btnPickField_Click"/>
                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="详情链接" FontSize="12" Foreground="#80FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSelLink" Grid.Column="1" Text="可选" FontSize="11"
                                           FontFamily="Consolas, Microsoft YaHei UI" Foreground="#66CCCCCC"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Content="点选" Style="{StaticResource TinyButton}"
                                        Tag="link" Click="btnPickField_Click"/>
                            </Grid>

                            <Border Height="1" Background="#1FFFFFFF" Margin="0,12,0,12"/>

                            <Grid>
                                <TextBlock Text="实时预览" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="#F2FFFFFF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtPreviewCount" Text="—" FontSize="11.5"
                                           Foreground="#FFD700" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel x:Name="previewList" Margin="0,9,0,0"/>

                            <TextBlock x:Name="txtPickStatus" FontSize="11.5" Foreground="#80CCCCCC"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ───────── 第 3 步：命名 + 连通性测试 ───────── -->
            <ScrollViewer x:Name="step3Panel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" Margin="0,26,0,24" HorizontalAlignment="Center">
                    <TextBlock Text="给它起个名字，然后测一下" FontSize="19" FontWeight="SemiBold"
                               Foreground="#F5FFFFFF"/>
                    <TextBlock Text="测试会真的用这个配置搜一次，能看到结果就说明配置可用。"
                               FontSize="12.5" Foreground="#80CCCCCC" Margin="0,8,0,0"/>

                    <TextBlock Text="站点名称" FontSize="12" Foreground="#B0CCCCCC" Margin="0,22,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" CornerRadius="9" Background="#1FFFFFFF"
                                VerticalAlignment="Center">
                            <Image x:Name="imgFavicon3" Width="22" Height="22"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBox x:Name="txtSiteName" Grid.Column="1" Style="{StaticResource Field}" Height="40"
                                 Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Border Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="14,12" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="搜索模板" FontSize="11.5" Foreground="#70CCCCCC"/>
                            <TextBlock x:Name="txtSummaryTemplate" Text="—" FontSize="12"
                                       FontFamily="Consolas, Microsoft YaHei UI" Foreground="#D9FFFFFF"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="选择器" FontSize="11.5" Foreground="#70CCCCCC" Margin="0,10,0,0"/>
                            <TextBlock x:Name="txtSummarySelectors" Text="—" FontSize="11.5"
                                       FontFamily="Consolas, Microsoft YaHei UI" Foreground="#9FCCCCCC"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="连通性测试" FontSize="12" Foreground="#B0CCCCCC" Margin="0,22,0,7"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtTestKeyword" Style="{StaticResource Field}" Height="38"
                                 VerticalContentAlignment="Center"/>
                        <Button x:Name="btnTest" Grid.Column="1" Content="测试搜索" Margin="10,0,0,0"
                                Style="{StaticResource WinButton}" Background="#2EFFD700"
                                Foreground="#FFD700" BorderBrush="#66FFD700" BorderThickness="1"
                                Click="btnTest_Click"/>
                    </Grid>

                    <Border x:Name="testResultCard" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF"
                            BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <TextBlock x:Name="txtTestResult" FontSize="12" Foreground="#CCCCCC"
                                   TextWrapping="Wrap" LineHeight="20"/>
                    </Border>

                    <TextBlock FontSize="11.5" Foreground="#5FFFFFFF" Margin="0,18,0,0" TextWrapping="Wrap"
                               Text="测试不通过也可以保存（比如该站点需要登录才能搜），之后可以在「已添加站点」里重新点选。"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═════════ 底栏 ═════════ -->
        <Border Grid.Row="2" Background="#191925" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
            <Grid Margin="18,0,14,0">
                <TextBlock x:Name="txtFooterStatus" FontSize="11.5" Foreground="#80CCCCCC"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,320,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource WinButton}" Background="#14FFFFFF"
                            BorderBrush="#26FFFFFF" BorderThickness="1" Click="btnClose_Click"/>
                    <Button x:Name="btnBack" Content="上一步" Style="{StaticResource WinButton}"
                            Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                            Margin="10,0,0,0" Click="btnBack_Click" Visibility="Collapsed"/>
                    <Button x:Name="btnNext" Content="下一步" Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0" Click="btnNext_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
