<Window x:Class="musicPlayer.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Width="400" SizeToContent="Height" MinWidth="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- 弹窗按钮：胶囊圆角，悬停/按下微降透明度（丝滑） -->
        <Style x:Key="DlgButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#66FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 半透明深色圆角卡片：任何系统上都保持圆角（不依赖 Win11 DWM） -->
    <Border Background="#F21A1A24" BorderBrush="#33FFFFFF" BorderThickness="1"
            CornerRadius="14" Padding="22,20,22,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行：状态徽章 + 标题（徽章颜色由代码按 危险/普通 设置） -->
            <StackPanel Orientation="Horizontal">
                <Border x:Name="iconBadge" Width="34" Height="34" CornerRadius="10"
                        Background="#26FF5252" VerticalAlignment="Center">
                    <TextBlock x:Name="txtIcon" Text="⚠" FontSize="15" Foreground="#FF7A7A"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="txtTitle" Text="确认操作" FontSize="14.5" FontWeight="SemiBold"
                           Foreground="#F2FFFFFF" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 正文 -->
            <TextBlock x:Name="txtMessage" Grid.Row="1" TextWrapping="Wrap" FontSize="12.5"
                       Foreground="#AACCCCCC" Margin="0,12,0,0" LineHeight="20"/>

            <!-- 按钮行：Esc=取消，Enter=确认（确认按钮初始聚焦） -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="btnCancel" Content="取消" Style="{StaticResource DlgButton}"
                        Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        Click="btnCancel_Click"/>
                <Button x:Name="btnConfirm" Content="确定" Style="{StaticResource DlgButton}"
                        Background="#E5484D" Margin="10,0,0,0"
                        Click="btnConfirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
