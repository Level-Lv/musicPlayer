<Window x:Class="musicPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="660" Width="600"
        MinHeight="540" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="#FF0E0E15"
        WindowStyle="None"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- 无边框但保留原生缩放：拖拽由顶栏 36px 的 CaptionHeight 接管 -->
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CaptionHeight="36"
                      CornerRadius="0" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <SolidColorBrush x:Key="AccentBrush" Color="#FFD700"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFE8B93A" Offset="0"/>
            <GradientStop Color="#FFD9A521" Offset="1"/>
        </LinearGradientBrush>

        <!-- ============================================================
             分区标题：图标徽章 + 标题 + 副标题（配合 SectionCard 使用）
             ============================================================ -->
        <Style x:Key="SectionIcon" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#26FFD700"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F2FFFFFF"/>
        </Style>
        <Style x:Key="SectionSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#77AAAAAA"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ============================================================
             幽灵按钮（与主窗口一致：悬停柔光 150ms 过渡）
             ============================================================ -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#14FFFFFF"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#30FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#14FFFFFF" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#44666666"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（金色渐变） -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF201800"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="{StaticResource AccentGradient}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                <Setter Property="Foreground" Value="#55201800"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮（移除/清除：悬停泛红） -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="#14FFFFFF"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#55FF5555" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#14FFFFFF" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#44666666"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             现代文本框：圆角 + 聚焦金色描边
             ============================================================ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#EEFFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFD700"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="9"
                                Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#77FFD700" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bd"
                                                Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                To="#22FFFFFF" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 路径展示框（只读）：弱化文字 -->
        <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Foreground" Value="#99CCCCCC"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- ============================================================
             现代列表：圆角条目 + 悬停提亮 + 选中金纱
             ============================================================ -->
        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#E2FFFFFF"/>
                        <Setter Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="#00FFFFFF"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="card" CornerRadius="9" Margin="0,2"
                                            Padding="12,9"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="card"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#1FFFFFFF" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="card"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#00FFFFFF" Duration="0:0:0.25"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="card" Property="Background" Value="#2EFFD700"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
        </Style>

        <!-- 现代滑块（与主窗口一致） -->
        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent" Width="16" Height="16">
                            <Ellipse x:Name="dot" Width="11" Height="11" Fill="White">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FFD700" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Height="18" Background="Transparent">
                                                    <Border Height="4" CornerRadius="2"
                                                            Background="{StaticResource AccentGradient}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Height="18" Background="Transparent">
                                                    <Border Height="4" CornerRadius="2" Background="#26FFFFFF"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代进度条 -->
        <Style x:Key="ModernProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 快捷键徽章 -->
        <Style x:Key="KeyChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 现代单选按钮：胶囊卡片，选中时金纱底 + 金色圆点 -->
        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#BBCCCCCC"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="9" Background="#14FFFFFF" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16" VerticalAlignment="Center">
                                    <Ellipse x:Name="ring" Stroke="#88AAAAAA" StrokeThickness="1.5" Fill="Transparent"/>
                                    <Ellipse x:Name="dot" Width="8" Height="8" Fill="#FFD700" Opacity="0"/>
                                </Grid>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Opacity" Value="1"/>
                                <Setter TargetName="ring" Property="Stroke" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="#F2FFFFFF"/>
                                <Setter TargetName="bd" Property="Background" Value="#2EFFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框（与主界面 cmbSearchScope 一致：整块可点击 + 悬停平滑高亮 + 选中淡金） -->
        <Style x:Key="ModernCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="9"
                                    Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"/>
                            <!-- 悬停高亮层：独立一层做淡入淡出；ToggleButton 必须用透明模板，
                                 否则默认按钮 chrome 悬停时会把整块泛亮 -->
                            <Border x:Name="hoverBd" CornerRadius="9" IsHitTestVisible="False">
                                <Border.Background>
                                    <SolidColorBrush Color="#00FFFFFF"/>
                                </Border.Background>
                            </Border>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,28,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              TextElement.Foreground="#DDFFFFFF"
                                              TextElement.FontSize="12.5"/>
                            <Path Data="M0,0 L4,4 8,0" Stroke="#99AAAAAA" StrokeThickness="1.5"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,10,0"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Placement="Bottom" PopupAnimation="Slide" Focusable="False">
                                <Border Background="#F21B1B26" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        CornerRadius="9" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="hoverBd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#1FFFFFFF" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="hoverBd"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#00FFFFFF" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#DDDDDD"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <!-- 选中态底色：默认全透明，选中时由 Style.Triggers 静态切到淡金 -->
                        <Setter Property="Background" Value="#00FFFFFF"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Grid>
                                        <!-- 选中底色层（也是整块的点击热区） -->
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}"/>
                                        <!-- 悬停高亮层（独立一层，动画只作用于它，不和选中态互相覆盖） -->
                                        <Border x:Name="hoverBd" CornerRadius="6" IsHitTestVisible="False">
                                            <Border.Background>
                                                <SolidColorBrush Color="#00FFFFFF"/>
                                            </Border.Background>
                                        </Border>
                                        <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="hoverBd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#2EFFD700" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetName="hoverBd"
                                                            Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                            To="#00FFFFFF" Duration="0:0:0.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#26FFD700"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细滚动条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2EFFFFFF" CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自绘标题栏：拖拽区 + 标题 + 关闭 -->
        <Border Grid.Row="0" Background="#B80E0E15">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="⚙" Foreground="#FFD700" FontSize="12"
                        VerticalAlignment="Center"/>
                    <TextBlock Text="设 置" Foreground="#CCFFFFFF" FontSize="12"
                        FontWeight="SemiBold" Margin="9,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="btnTitleClose" Content="✕" Click="btnClose_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="40" FontSize="10" Padding="0"
                    ToolTip="关闭" Cursor="Hand"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                    TextBlock.Foreground="#AAFFFFFF"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                    <Setter Property="TextBlock.Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,16,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============ 1. 音乐文件夹 ============ -->
                <Border Background="#16141420" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="14" Padding="18,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="🎵" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="音乐文件夹" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                        </StackPanel>

                        <ListBox x:Name="listFolders" Height="118" Margin="0,12,0,0"
                                 Style="{StaticResource ModernListBox}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="btnAddFolder" Content="添加文件夹…" Click="btnAddFolder_Click"
                                    Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                            <Button x:Name="btnRemoveFolder" Content="移除选中" Click="btnRemoveFolder_Click"
                                    Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                            <Button x:Name="btnRescan" Content="重新扫描全部" Click="btnRescan_Click"
                                    Style="{StaticResource GhostButton}"/>
                        </StackPanel>

                        <!-- 扫描进度（扫描时才显示） -->
                        <StackPanel x:Name="panelScanProgress" Visibility="Collapsed" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="progressScan" Minimum="0" Maximum="100"
                                             Style="{StaticResource ModernProgress}"/>
                                <Button Grid.Column="1" Content="取消" Click="btnCancelScan_Click"
                                        Style="{StaticResource GhostButton}"
                                        Margin="12,0,0,0" Padding="12,4" MinWidth="0"/>
                            </Grid>
                            <TextBlock x:Name="txtScanStatus" Foreground="#99AAAAAA" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 2. 歌词文件夹 ============ -->
                <Border Background="#16141420" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="14" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="📝" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="歌词文件夹" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtLyricsFolder" IsReadOnly="True"
                                     Style="{StaticResource PathBox}" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="选择…" Click="btnPickLyricsFolder_Click"
                                    Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="清除" Click="btnClearLyricsFolder_Click"
                                    Style="{StaticResource DangerButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 3. 背景 ============ -->
                <Border Background="#16141420" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="14" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="🖼" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="背景" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="btnPickBgImage" Content="选择图片…" Click="btnPickBgImage_Click"
                                    Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                            <Button x:Name="btnPickBgVideo" Content="选择视频…" Click="btnPickBgVideo_Click"
                                    Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                            <Button x:Name="btnClearBg" Content="清除背景" Click="btnClearBg_Click"
                                    Style="{StaticResource DangerButton}"/>
                        </StackPanel>

                        <TextBox x:Name="txtBackground" IsReadOnly="True"
                                 Style="{StaticResource PathBox}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ============ 4. 播放设置 ============ -->
                <Border Background="#16141420" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="14" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="▶" FontSize="14" Foreground="#FFD700"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="播放设置" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="播放方式" Foreground="#99CCCCCC" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <ComboBox x:Name="cmbPlayMode" Grid.Column="1" Width="170"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource ModernCombo}"
                                      SelectionChanged="cmbPlayMode_SelectionChanged">
                                <ComboBoxItem Content="顺序播放" Tag="sequential"/>
                                <ComboBoxItem Content="随机播放" Tag="shuffle"/>
                                <ComboBoxItem Content="单曲循环" Tag="repeat_one"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="默认音量" Foreground="#99CCCCCC" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="0,16,16,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,16,0,0">
                                <Slider x:Name="sliderDefaultVolume" Width="220" Minimum="0" Maximum="100"
                                        Style="{StaticResource ModernSlider}"
                                        VerticalAlignment="Center"
                                        ValueChanged="sliderDefaultVolume_ValueChanged"/>
                                <Border Style="{StaticResource KeyChip}" Margin="12,0,0,0">
                                    <TextBlock x:Name="txtDefaultVolume" Foreground="#FFD700"
                                               FontSize="11.5" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 4.5 窗口行为 ============ -->
                <Border Background="#16141420" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="14" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="🪟" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="rbCloseToTray" GroupName="CloseAction"
                                         Content="最小化到托盘" Style="{StaticResource ModernRadio}"
                                         ToolTip="窗口隐藏到系统托盘，双击托盘图标恢复；右键可切歌/退出"
                                         Checked="CloseAction_Changed"/>
                            <RadioButton x:Name="rbCloseExit" GroupName="CloseAction"
                                         Content="直接退出程序" Style="{StaticResource ModernRadio}"
                                         Checked="CloseAction_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 5. 主题 + 快捷键 ============ -->
                <Border Background="#16141420" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="14" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="🎨" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="主题与快捷键" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource KeyChip}">
                                    <TextBlock Text="◐ 暗色" Foreground="#FFD700" FontSize="11.5"/>
                                </Border>
                            </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource KeyChip}"><TextBlock Text="空格" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Column="1" Text="播放 / 暂停" Foreground="#99CCCCCC" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="1" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="Ctrl + A / D" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="上一首 / 下一首" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="2" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="Ctrl + W / S" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="音量加大 / 减小" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="3" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="↑ / ↓" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="选中上 / 下一首歌曲" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="4" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="Enter" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="播放当前选中的歌曲" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="5" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="M" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="静音切换" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="6" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="L" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="桌面歌词开关" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="7" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="Ctrl + F" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="聚焦搜索框" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="8" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="S" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="收起 / 展开侧栏（歌词铺满）" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="9" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="Esc" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="9" Grid.Column="1" Text="清除搜索 / 关闭弹窗" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>

                            <Border Grid.Row="10" Style="{StaticResource KeyChip}" Margin="0,7,0,0"><TextBlock Text="Delete" FontSize="11" Foreground="#DDDDDD"/></Border>
                            <TextBlock Grid.Row="10" Grid.Column="1" Text="从当前歌单移除选中歌曲" Foreground="#99CCCCCC" FontSize="12" Margin="12,7,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 6. 数据位置 ============ -->
                <Border Background="#16141420" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        CornerRadius="14" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{StaticResource SectionIcon}">
                                <TextBlock Text="💾" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="数据位置" Style="{StaticResource SectionTitle}"/>
                                </StackPanel>
                        </StackPanel>

                        <TextBox x:Name="txtDbPath" IsReadOnly="True"
                                 Style="{StaticResource PathBox}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部关闭按钮 -->
        <Button Grid.Row="1" Content="关 闭" Click="btnClose_Click"
                Style="{StaticResource AccentButton}"
                HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="96" Padding="0,9"/>
        </Grid>
    </Grid>
</Window>
