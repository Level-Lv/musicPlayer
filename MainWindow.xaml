<Window x:Name="musicPlayerForm" x:Class="musicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:musicPlayer"
        mc:Ignorable="d"
        Title="音乐播放器" Height="600" Width="1000">        
    
    <Window.Resources>
        <Storyboard x:Key="SpinningAnimation" x:Name="SpinningStoryboard">
            <DoubleAnimation 
            Storyboard.TargetName="RotationTransform" 
            Storyboard.TargetProperty="Angle" 
            From="0" To="360" 
            Duration="0:0:5"         RepeatBehavior="Forever" />
        </Storyboard>

        <Style x:Key="NormalLyricTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0, 5, 0, 5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="0.5" BlurRadius="5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HighlightLyricTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource NormalLyricTextBlockStyle}">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" Color="#FFD700" Opacity="0.8" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.5*"/>
            <RowDefinition Height="18.5*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300*"/>
            <ColumnDefinition Width="700*"/>
        </Grid.ColumnDefinitions>

        <MediaElement x:Name="backgroundVideo"
            Source="{x:Null}" Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            LoadedBehavior="Manual" 
            UnloadedBehavior="Manual"
            Stretch="UniformToFill"
            Volume="0"
            IsMuted="True"
            Visibility="Visible"
            Panel.ZIndex="-1"
            MediaEnded="backgroundVideo_MediaEnded" />

        <Grid Grid.Row="0" Grid.Column="0" Margin="5" Background="Transparent">
            <Button x:Name="btnSelectFolder" 
                HorizontalAlignment="Left"
                Padding="8,4"
                Background="Transparent"
                Click="btnSelectFolder_Click">
                📁 选择文件夹
            </Button>
            <Button x:Name="btnShuffle"
                HorizontalAlignment="Right"
                Padding="8,4"
                Background="Transparent"
                Click="btnShuffle_Click">
                🔀 随机播放
            </Button>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="1" Margin="5" Background="Transparent">
            <Button x:Name="btnSetBackgroundVideo"
                Content="🎬 设置背景视频"
                HorizontalAlignment="Right"
                Padding="8,4"
                Background="Transparent"
                Click="btnSetBackgroundVideo_Click"/>
        </Grid>

        <ListView x:Name="musicfilesListView"
          d:ItemsSource="{d:SampleData ItemCount=100}"
          Grid.Column="0"
          Grid.Row="1"
          Margin="1"
          Background="Transparent"
          MouseDoubleClick="musicfilesListView_MouseDoubleClick">

            <ListView.Resources>
                <Style TargetType="{x:Type ScrollBar}">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>

                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="LightGray"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Grid>
                                    <Border x:Name="HeaderBorder" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    Background="{TemplateBinding Background}" 
                                    Padding="{TemplateBinding Padding}">

                                        <ContentPresenter x:Name="HeaderContent" 
                                              Margin="0" 
                                              RecognizesAccessKey="True" 
                                              Content="{TemplateBinding Content}" 
                                              ContentTemplate="{TemplateBinding ContentTemplate}" 
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="DarkGray"/>
                            <Setter Property="Foreground" Value="Silver"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="歌曲"
                            Width="160"
                            DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="时长"
                            Width="100"
                            DisplayMemberBinding="{Binding Duration, StringFormat={}{0:mm\\:ss}}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <Grid Grid.Row="1" Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="LyricsScrollViewer" Grid.Row="0" 
                  VerticalScrollBarVisibility="Hidden"
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Stretch"
                  Margin="10"
                  Panel.ZIndex="1">
                
                <ScrollViewer.IsHitTestVisible>False</ScrollViewer.IsHitTestVisible>
                
                <StackPanel x:Name="LyricsPanel" 
                    Orientation="Vertical"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock Text="双击列表播放音乐以显示歌词" 
                       Foreground="Gray" 
                       FontSize="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Visible"/>

                </StackPanel>
            </ScrollViewer>

            <Viewbox Grid.Row="0" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="VisualizerGrid" Width="100" Height="100" MouseLeftButtonDown="VisualizerGrid_MouseLeftButtonDown">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="RotationTransform" CenterX="50" CenterY="50"/>
                    </Grid.RenderTransform>

                    <Ellipse Fill="#FF333333" Width="100" Height="100"/>
                    <Ellipse Stroke="Silver" StrokeThickness="1" Width="100" Height="100">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AlbumCoverBrush"  
                            Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Fill="Transparent" Stroke="Silver" StrokeThickness="1" Width="10" Height="10"/>
                </Grid>
            </Viewbox>

            <Slider x:Name="sliderProgress" 
                Grid.Row="1" 
                Margin="10, 5" 
                IsMoveToPointEnabled="True" 
                Minimum="0" 
                Maximum="100" 
                Value="0"
                PreviewMouseUp="sliderProgress_PreviewMouseUp" />
            <Grid Grid.Row="2" Margin="10, 0">
                <TextBlock x:Name="txtCurrentTime" Text="00:00" Foreground="LightGray" HorizontalAlignment="Left" />
                <TextBlock x:Name="txtTotalTime" Text="00:00" Foreground="LightGray" HorizontalAlignment="Right" />
            </Grid>

            <Grid Grid.Row="3" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="btnPlayPause" Content="▶️" Padding="8,4" Margin="5" Background="Transparent" Click="btnPlayPause_Click" />
                </StackPanel>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Button x:Name="btnShuffleToggle" 
                        Content="🔀"  
                        Padding="8,4"  
                        Margin="0, 0, 30, 0"  Background="Transparent"
                        Click="btnShuffleToggle_Click" />

                    <Button x:Name="btnPrevious" Content="⏮️" Padding="8,4" Margin="5" Background="Transparent" Click="btnPrevious_Click" />

                </StackPanel>


                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                    <Button x:Name="btnNext" Content="⏭️" Padding="8,4" Margin="5" Background="Transparent" Click="btnNext_Click" />

                    <Button Width="{Binding ElementName=btnShuffleToggle, Path=ActualWidth}"
                        Height="{Binding ElementName=btnShuffleToggle, Path=ActualHeight}"
                        Visibility="Hidden"  
                        Margin="30, 0, 0, 0" />
                </StackPanel>
            </Grid>


            <MediaElement x:Name="mediaPlayer"
                      Grid.RowSpan="4"  LoadedBehavior="Manual"
                      Visibility="Collapsed"
                      MediaEnded="mediaPlayer_MediaEnded" 
                      MediaOpened="mediaPlayer_MediaOpened" />
        </Grid>

    </Grid>
</Window>
