<Window x:Class="musicPlayer.LyricsDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面歌词" 
        Height="150" Width="800"
        
        WindowStyle="None"              AllowsTransparency="True"       Background="Transparent"        Topmost="True"                  ShowInTaskbar="False"           ResizeMode="NoResize"
        Opacity="0.9"
        
        WindowStartupLocation="CenterScreen"  MouseDown="Window_MouseDown"    Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="NormalLyricTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0, 5, 0, 5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="0.5" BlurRadius="5"/>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="HighlightLyricTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource NormalLyricTextBlockStyle}">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="0" Color="#FFD700" Opacity="0.8" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel x:Name="DesktopLyricsPanel" 
                Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <TextBlock x:Name="txtPlaceholder" Text="歌词加载中..."
                   Foreground="#CCCCCC" FontSize="28" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" Margin="0, 5, 0, 5" Opacity="0.5">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="0" Color="Black" Opacity="0.5" BlurRadius="5"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>