<Window x:Class="musicPlayer.OnlineDiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="在线功能诊断" Width="560" SizeToContent="Height" MaxHeight="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="DlgButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左标签 -->
        <Style x:Key="DiagLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8FCCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 右值 -->
        <Style x:Key="DiagValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#E8FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Border Background="#F21A1A24" BorderBrush="#33FFFFFF" BorderThickness="1"
            CornerRadius="14" Padding="22,18,22,18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#26FFD700"
                            VerticalAlignment="Center">
                        <TextBlock Text="🧪" FontSize="14" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="在线功能诊断" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="#F2FFFFFF"/>
                        <TextBlock Text="隐藏内核状态 · 空闲回收 · 基础自检"
                                   FontSize="11" Foreground="#80CCCCCC" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="28" Height="26" FontSize="12" Cursor="Hand"
                        Style="{StaticResource DlgButton}" Padding="0"
                        Background="#14FFFFFF" Click="btnClose_Click"/>
            </Grid>

            <!-- 状态卡片 -->
            <Border Grid.Row="1" Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    CornerRadius="10" Padding="14,12" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="WebView2" Style="{StaticResource DiagLabel}"/>
                    <TextBlock x:Name="txtRuntime" Grid.Column="1" Style="{StaticResource DiagValue}" Text="检索中…"/>

                    <TextBlock Grid.Column="3" Text="ffmpeg" Style="{StaticResource DiagLabel}"/>
                    <TextBlock x:Name="txtFfmpeg" Grid.Column="4" Style="{StaticResource DiagValue}" Text="检索中…"/>

                    <TextBlock Grid.Row="1" Text="内核状态" Style="{StaticResource DiagLabel}" Margin="0,7,0,0"/>
                    <TextBlock x:Name="txtKernelState" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0"
                               Style="{StaticResource DiagValue}" Text="—"/>

                    <TextBlock Grid.Row="1" Grid.Column="3" Text="空闲回收" Style="{StaticResource DiagLabel}"
                               Margin="0,7,0,0"/>
                    <TextBlock x:Name="txtIdle" Grid.Row="1" Grid.Column="4" Margin="0,7,0,0"
                               Style="{StaticResource DiagValue}" Text="—"/>

                    <TextBlock Grid.Row="2" Text="内核进程" Style="{StaticResource DiagLabel}" Margin="0,7,0,0"/>
                    <TextBlock x:Name="txtKernelProcs" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0"
                               Style="{StaticResource DiagValue}" Text="—"/>

                    <TextBlock Grid.Row="2" Grid.Column="3" Text="主进程工作集" Style="{StaticResource DiagLabel}"
                               Margin="0,7,0,0" ToolTip="含共享页，数值略高于任务管理器「内存」列（专用工作集）"/>
                    <TextBlock x:Name="txtOwnMemory" Grid.Row="2" Grid.Column="4" Margin="0,7,0,0"
                               Style="{StaticResource DiagValue}" Text="—"/>

                    <TextBlock Grid.Row="3" Text="用户数据" Style="{StaticResource DiagLabel}" Margin="0,7,0,0"/>
                    <TextBlock x:Name="txtUserData" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                               Margin="0,7,0,0" Style="{StaticResource DiagValue}" Text="—"/>
                </Grid>
            </Border>

            <!-- 日志 -->
            <Border Grid.Row="2" Background="#0A000000" BorderBrush="#1AFFFFFF" BorderThickness="1"
                    CornerRadius="10" Margin="0,12,0,0" Padding="10,8" MinHeight="132">
                <ScrollViewer x:Name="logScroll" MaxHeight="190" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="txtLog" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                               FontSize="11.5" Foreground="#B8D8D8D8" LineHeight="18"
                               TextWrapping="Wrap" Text="点击「运行内核自检」开始。&#10;"/>
                </ScrollViewer>
            </Border>

            <!-- 按钮行 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="btnRecycle" Content="立即释放内核" Style="{StaticResource DlgButton}"
                        Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        Click="btnRecycle_Click"/>
                <Button x:Name="btnSelfTest" Content="运行内核自检" Style="{StaticResource DlgButton}"
                        Background="#2EFFD700" Margin="10,0,0,0" Click="btnSelfTest_Click"/>
                <Button x:Name="btnCopy" Content="复制结果" Style="{StaticResource DlgButton}"
                        Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        Margin="10,0,0,0" Click="btnCopy_Click"/>
                <Button Content="关闭" Style="{StaticResource DlgButton}"
                        Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        Margin="10,0,0,0" Click="btnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
